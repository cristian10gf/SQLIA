# Copiar a `.env.prod` en el servidor (no commitear valores reales).
# Usar con: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

POSTGRES_IMAGE_TAG=15-alpine
REDIS_IMAGE_TAG=7-alpine

POSTGRES_USER=sqlia_user
POSTGRES_PASSWORD=cambiar-password-seguro
POSTGRES_DB=sqlia_db

REDIS_MAXMEMORY=512mb

API_PORT=3000

# Dentro de la red Docker Compose los hosts son los nombres de servicio.
DATABASE_URL=postgresql://sqlia_user:cambiar-password-seguro@postgres:5432/sqlia_db
# BullMQ: mismo Redis que REDIS_HOST o URL gestionada (TLS/rediss:// en cloud):
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL=rediss://:password@host:6380

JWT_SECRET=cambiar-secret-largo-y-aleatorio
PORT=3000

# --- Sandbox Postgres por reto (API en contenedor: monta docker.sock en compose) ---
SANDBOX_POSTGRES_IMAGE=postgres:16
SQL_SANDBOX_DB_HOST=host.docker.internal
SANDBOX_DEFAULT_TTL_DAYS=30
# SANDBOX_TTL_DAYS=
# DOCKER_HOST=  # solo si el daemon no está en /var/run/docker.sock

BULLMQ_STALLED_INTERVAL_MS=45000

# Opcional — IA
# AI_URL=
# AI_API_KEY=
