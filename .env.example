# Ejemplo para desarrollo local (copiar a `.env` o usar `.env.dev` con Compose).
DATABASE_URL=postgresql://sqlia_user:sqlia_password@localhost:5432/sqlia_db

# Redis (BullMQ): URL única O host/puerto — ver createBullRedisConnection en src/config/bull-redis.factory.ts
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=true

JWT_SECRET=cambiar-en-desarrollo
PORT=3000

# Sandbox Docker (Bull `challenge-sandbox` + runner SQL)
SANDBOX_POSTGRES_IMAGE=postgres:16
SQL_RUNNER_IMAGE=postgres:16
SQL_SANDBOX_DB_HOST=127.0.0.1

# TTL del sandbox cuando el reto no está en ninguna evaluación (días desde aprovisionamiento)
SANDBOX_TTL_DAYS=30
SANDBOX_DEFAULT_TTL_DAYS=30

SQL_RUNNER_MEMORY_BYTES=536870912
SQL_RUNNER_NANO_CPUS=500000000

# BullMQ
BULLMQ_STALLED_INTERVAL_MS=45000

# Submission RUNNING huérfanas (cron interno Nest)
SUBMISSION_RUNNING_STALE_MS=900000
SUBMISSION_RUNNING_RECOVERY_INTERVAL_MS=300000

OPTIMIZATION_TIME_RATIO=0.85

# Windows Docker Desktop opcional:
# DOCKER_HOST=npipe:////./pipe/docker_engine
