# Copiar a `.env.dev` para Docker Compose (dev) y desarrollo local.
# Uso: docker compose --env-file .env.dev -f docker-compose.dev.yml up -d

# --- Postgres (contenedor sqlia-postgres-dev) ---
POSTGRES_IMAGE_TAG=15-alpine
POSTGRES_PORT=5432
POSTGRES_USER=sqlia_user
POSTGRES_PASSWORD=sqlia_password
POSTGRES_DB=sqlia_db

# URL que usa Nest/Prisma en el host (localhost → puertos del compose).
DATABASE_URL=postgresql://sqlia_user:sqlia_password@localhost:5432/sqlia_db

# Prisma 7 (prisma.config.ts): URL directa para migraciones. Si no se define, Prisma usa DATABASE_URL vía fallback en schema.
# DIRECT_URL=postgresql://sqlia_user:sqlia_password@localhost:5432/sqlia_db

# --- Redis (BullMQ / Nest BullModule.forRootAsync) ---
# Opción A — URL única (ej. Redis Cloud, TLS en la URL: rediss://):
# REDIS_URL=redis://localhost:6379
# Opción B — host/puerto (Compose local):
REDIS_HOST=localhost
REDIS_PORT=6379
# Opción B — ACL / contraseña (omitir si no aplica):
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# TLS sin URL (ej. endpoint que exige TLS):
# REDIS_TLS=true
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Variables solo para docker-compose.dev.yml (imagen Redis del stack):
REDIS_IMAGE_TAG=7-alpine
REDIS_MAXMEMORY=256mb

# --- API ---
API_PORT=3000
JWT_SECRET=cambiar-en-desarrollo
PORT=3000

# --- Sandbox Postgres por reto (Docker + cola challenge-sandbox) ---
# Imagen de los contenedores efímeros de validación y de sandbox nombrado sqlia-challenge-<uuid>
SANDBOX_POSTGRES_IMAGE=postgres:16-alpine
SQL_RUNNER_IMAGE=postgres:16-alpine
# Host desde el que workers conectan al Postgres publicado del sandbox:
# - Nest en el host: 127.0.0.1
# - Nest en contenedor API (Docker Desktop): host.docker.internal
SQL_SANDBOX_DB_HOST=127.0.0.1
# TTL si el reto no está en ninguna evaluación (días)
SANDBOX_DEFAULT_TTL_DAYS=30

# Límites por contenedor (opcional)
# SQL_RUNNER_MEMORY_BYTES=536870912
# SQL_RUNNER_NANO_CPUS=500000000

# Docker Engine (Windows Docker Desktop suele requerir npipe; Linux/Mac suele omitirse)
# DOCKER_HOST=npipe:////./pipe/docker_engine

# --- BullMQ workers ---
# Detección de jobs stalled (ms). También acepta BULLMQ_STALLED_INTERVAL_MS.
BULL_STALLED_INTERVAL_MS=45000
# Bloqueo máximo del job de evaluación SQL (ms)
SQL_EVALUATION_LOCK_MS=120000
# Bloqueo máximo del job de aprovisionamiento sandbox (provision puede tardar varios minutos)
CHALLENGE_SANDBOX_LOCK_MS=600000

# --- Recuperación submissions RUNNING + mantenimiento sandbox (requiere @nestjs/schedule) ---
SUBMISSION_RECOVERY_INTERVAL_MS=300000
SUBMISSION_RUNNING_STALE_MS=900000
# Intervalo del cron de mantenimiento de sandboxes Docker (PROVISIONING colgado, READY vencido)
SANDBOX_MAINTENANCE_INTERVAL_MS=600000
# Si PROVISIONING no avanza más de este tiempo → ERROR + limpieza de contenedor (default 1 h)
SANDBOX_PROVISIONING_STALE_MS=3600000

# Ratio tiempo vs límite para marcar OPTIMIZATION_REQUIRED (resultado correcto pero lento)
OPTIMIZATION_TIME_RATIO=0.85

# --- IA (opcional) ---
# AI_URL=
# AI_API_KEY=
