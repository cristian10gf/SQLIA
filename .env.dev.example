# Copiar a `.env.dev` para Docker Compose (dev) y/o desarrollo local.
# Docker Compose sustituye ${VAR} en docker-compose.dev.yml leyendo este archivo si pasás:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d

POSTGRES_IMAGE_TAG=15-alpine
POSTGRES_PORT=5432
POSTGRES_USER=sqlia_user
POSTGRES_PASSWORD=sqlia_password
POSTGRES_DB=sqlia_db

REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

API_PORT=3000

# NestJS en tu máquina (localhost → puertos publicados por Compose dev).
# REDIS_PORT coincide con el mapeo de Redis arriba.
DATABASE_URL=postgresql://sqlia_user:sqlia_password@localhost:5432/sqlia_db
REDIS_HOST=localhost

JWT_SECRET=cambiar-en-desarrollo
PORT=3000

# Opcional (servicios de IA)
# AI_URL=https://api.example.com/v1
# AI_API_KEY=
