// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSOR
  STUDENT
}

enum ChallengeVisibility {
  PUBLIC
  PRIVATE
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  SYNTAX_ERROR
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  OPTIMIZATION_REQUIRED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  fullName  String   @map("full_name")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  coursesAsProfessor Course[]     @relation("CourseProfessor")
  enrollments        Enrollment[]
  challenges         Challenge[]  @relation("ChallengeCreator")
  submissions        Submission[]

  @@map("users")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  period      String
  group       String?
  professorId String   @map("professor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  professor   User         @relation("CourseProfessor", fields: [professorId], references: [id])
  enrollments Enrollment[]
  challenges  Challenge[]
  evaluations Evaluation[]

  @@index([professorId], name: "idx_course_professor")
  @@map("courses")
}

model Enrollment {
  studentId  String   @map("student_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@id([courseId, studentId])
  @@map("enrollments")
}

model Challenge {
  id               String              @id @default(uuid()) @db.Uuid
  courseId         String?             @map("course_id") @db.Uuid
  createdBy        String              @map("created_by") @db.Uuid
  title            String
  description      String
  difficulty       DifficultyLevel
  visibility       ChallengeVisibility @default(PRIVATE)
  databaseEngine   String              @default("PostgreSQL") @map("database_engine")
  schemaDefinition String              @map("schema_definition")
  seedScript       String?             @map("seed_script")
  expectedResult   Json                @map("expected_result")
  timeLimitMs      Int                 @default(2000) @map("time_limit_ms")
  status           ChallengeStatus     @default(DRAFT)
  createdAt        DateTime            @default(now()) @map("created_at")

  course         Course?               @relation(fields: [courseId], references: [id])
  creator        User                  @relation("ChallengeCreator", fields: [createdBy], references: [id])
  dataGenConfigs DataGenConfig[]
  evaluations    EvaluationChallenge[]
  submissions    Submission[]

  @@index([courseId], name: "idx_challenge_course")
  @@index([visibility], name: "idx_challenge_visibility")
  @@map("challenges")
}

model DataGenConfig {
  id          String @id @default(uuid()) @db.Uuid
  challengeId String @map("challenge_id") @db.Uuid
  tableName   String @map("table_name")
  rowCount    Int    @map("row_count")
  configJson  Json   @map("config_json")

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@map("data_gen_configs")
}

model Evaluation {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  title           String
  description     String?
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  durationMinutes Int      @map("duration_minutes")
  maxAttempts     Int      @default(1) @map("max_attempts")
  isVisible       Boolean  @default(false) @map("is_visible")

  course      Course                @relation(fields: [courseId], references: [id])
  challenges  EvaluationChallenge[]
  submissions Submission[]

  @@map("evaluations")
}

model EvaluationChallenge {
  evaluationId String @map("evaluation_id") @db.Uuid
  challengeId  String @map("challenge_id") @db.Uuid
  orderIndex   Int?   @map("order_index")
  points       Int    @default(10)

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  challenge  Challenge  @relation(fields: [challengeId], references: [id])

  @@id([evaluationId, challengeId])
  @@map("evaluation_challenges")
}

model Submission {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  challengeId     String           @map("challenge_id") @db.Uuid
  evaluationId    String?          @map("evaluation_id") @db.Uuid
  query           String
  status          SubmissionStatus @default(QUEUED)
  executionTimeMs Int?             @map("execution_time_ms")
  score           Decimal?         @default(0) @db.Decimal
  createdAt       DateTime         @default(now()) @map("created_at")

  student        User              @relation(fields: [studentId], references: [id])
  challenge      Challenge         @relation(fields: [challengeId], references: [id])
  evaluation     Evaluation?       @relation(fields: [evaluationId], references: [id])
  recommendation AiRecommendation?

  @@index([studentId], name: "idx_submission_student")
  @@index([challengeId], name: "idx_submission_challenge")
  @@map("submissions")
}

model AiRecommendation {
  id               String   @id @default(uuid()) @db.Uuid
  submissionId     String   @unique @map("submission_id") @db.Uuid
  analysisText     String   @map("analysis_text")
  suggestedQuery   String?  @map("suggested_query")
  suggestedIndices String?  @map("suggested_indices")
  tokensUsed       Int?     @map("tokens_used")
  modelUsed        String?  @default("gpt-4") @map("model_used")
  createdAt        DateTime @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id])

  @@map("ai_recommendations")
}
